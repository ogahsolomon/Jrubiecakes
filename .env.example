[TEMPLATE]
# Environment variables for Jrubiecakes
# Copy this file to .env.local and fill in the values.

# ---- Supabase (Project Settings -> API) ----
# Public: safe to expose to the browser (anon key)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# SECRET: server-only. Never expose to the client. Used for admin operations
# (webhook payment updates, product seeding, storage uploads from server).
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ---- Site ----
# Use your production URL in Vercel, or local dev URL (e.g. http://localhost:3003)
NEXT_PUBLIC_SITE_URL=http://localhost:3003

# ---- Paystack (see docs/paystack-setup.md for the full walkthrough) ----
# Keys from dashboard.paystack.com -> Settings -> API Keys & Webhooks
# Public: the publishable key is safe in the browser
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxx
# SECRET: server-only. Never expose. Used to init/verify transactions.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxx
# Webhook signing secret (Paystack dashboard shows it under Webhooks)
PAYSTACK_WEBHOOK_SECRET=whsec_xxxxxxxx
# Optional: only calls from your app to the init endpoint need this
PAYSTACK_CALLBACK_URL_BASE=http://localhost:3000

# SECRET: protects the cron endpoint /api/cron/expire-payments, which marks
# Paystack payments still pending after 24h as abandoned. Call it with
# "Authorization: Bearer <CRON_SECRET>". Leave unset to disable the endpoint.
CRON_SECRET=

# ---- Brevo (app.brevo.com -> SMTP & API -> API Keys) ----
# Transactional email via the Brevo v3 sendTransacEmail endpoint.
# The API key (starts with "xkeysib-") is the only credential required.
BREVO_API_KEY=xkeysib-xxxxxxxx
# The sender must be an address already verified in Brevo (Senders & Domains),
# otherwise every send fails with "unauthorized". Accepts either a bare address
# or the combined "Name <email>" form.
BREVO_FROM_EMAIL=Jrubiecakes <orders@yourdomain.com>
# Optional: overrides the display name recipients see. Brevo caps this at 70
# characters, so longer values are truncated rather than rejected.
BREVO_FROM_NAME=Jrubiecakes
# Optional: where replies to your emails go. Defaults to the sender address.
BREVO_REPLY_TO=
# Where admin notifications go
ADMIN_EMAIL=orders@jrubiecakes.com

# ---- Auth (generate with: openssl rand -base64 32) ----
# Used by @supabase/ssr cookie handling in middleware
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase

# ---- Google OAuth (see docs/google-oauth-setup.md for the full walkthrough) ----
# No Google credentials belong in this file: the OAuth client ID/secret are
# stored in the Supabase dashboard (Auth -> Providers -> Google), never in
# Use your production URL in Vercel, or local dev URL (e.g. http://localhost:3003)
NEXT_PUBLIC_SITE_URL=http://localhost:3003
# you must register with Google and Supabase.

# ---- Admin bootstrap ----
# After signing up with this email via Google OAuth or email, the user is
# auto-promoted to admin (see scripts/promote-admin.sql alternative).
ADMIN_BOOTSTRAP_EMAIL=your-admin-email@gmail.com
